# Copie para .env e substitua todos os valores de exemplo.
PORT=8080
DATABASE_URL=postgres://diagnostico:SUBSTITUA_A_SENHA@localhost:5432/diagnostico?sslmode=disable
DATA_DIR=/opt/diagnostico-escolar/data
TZ=America/Sao_Paulo

# Administrador criado somente quando o banco ainda não possui usuários.
ADMIN_USUARIO=admin
ADMIN_SENHA=SUBSTITUA_POR_UMA_SENHA_FORTE

# Cloudflare R2: crie um bucket privado e uma chave S3 com acesso a esse bucket.
R2_ACCOUNT_ID=SUBSTITUA_PELO_ACCOUNT_ID
R2_BUCKET=diagnostico-escolar
R2_ACCESS_KEY_ID=SUBSTITUA_PELA_ACCESS_KEY
R2_SECRET_ACCESS_KEY=SUBSTITUA_PELA_SECRET_KEY
# Opcional; o padrão é https://<ACCOUNT_ID>.r2.cloudflarestorage.com
R2_ENDPOINT=

# Usada pelo Docker Compose para PostgreSQL.
POSTGRES_PASSWORD=SUBSTITUA_A_SENHA_DO_POSTGRES