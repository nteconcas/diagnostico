[Unit]
Description=Formulário de Diagnóstico Escolar (Go + React)
After=network.target postgresql.service
Wants=postgresql.service

[Service]
Type=simple
User=diagnostico
Group=diagnostico
WorkingDirectory=/opt/diagnostico-escolar
ExecStart=/opt/diagnostico-escolar/diagnostico-escolar
EnvironmentFile=/opt/diagnostico-escolar/.env
Restart=always
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full

[Install]
WantedBy=multi-user.target
